<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DWAP.ViewModels"
        xmlns:models="using:DWAP.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="760"
        Width="820" Height="760"
        x:Class="DWAP.Views.RecruitmentTrackerWindow"
        x:DataType="vm:RecruitmentTrackerViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Recruitment Tracker"
        Background="#1B1F22">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style Selector="Image.sprite">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>
    <ScrollViewer Padding="15">
        <StackPanel Spacing="18">

            <StackPanel Spacing="6">
                <TextBlock Text="Recruitments" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="Gray = not started, Yellow = Soul received, Green = recruited" FontSize="11" Foreground="#AAAAAA" />
                <Border Background="#2D3840" Padding="10" CornerRadius="4">
                    <ItemsControl ItemsSource="{Binding Recruitments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:RecruitmentStatus">
                                <Border Classes="tile" Background="{Binding StatusColor}" ToolTip.Tip="{Binding Name}">
                                    <Image Classes="sprite" Source="{Binding Sprite}" RenderOptions.BitmapInterpolationMode="None" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Text="{Binding Summary}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Wild Encounters" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="Gray = not beaten, Green = beaten" FontSize="11" Foreground="#AAAAAA" />
                <Border Background="#2D3840" Padding="10" CornerRadius="4">
                    <ItemsControl ItemsSource="{Binding WildEncounters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:WildEncounterStatus">
                                <Border Classes="tile" Background="{Binding StatusColor}" ToolTip.Tip="{Binding Name}">
                                    <Image Classes="sprite" Source="{Binding Sprite}" RenderOptions.BitmapInterpolationMode="None" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Text="{Binding WildSummary}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
